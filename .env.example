# 应用配置
APP_NAME=Japanese Subtitle Learning Analysis API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS 配置
# 开发环境可以使用 ["*"] 允许所有源
# 生产环境建议限制为特定域名
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 缓存配置
# CACHE_ENABLED=true
# CACHE_TTL=300
# CACHE_MAX_SIZE=1000

# 大模型配置（OpenAI 兼容 Chat Completions 接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2

# 旧版规则/词库配置（仅为历史兼容保留）
GRAMMAR_RULES_FILE=data/grammar_rules_complete.json
VOCABULARY_LEVELS_FILE=data/vocabulary_levels.json
MECAB_DICT_TYPE=ipadic
